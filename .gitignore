# The site's own build output and env files are ignored in frontend/.gitignore.
# These rules cover the whole repo.

# Dependencies (the site and the Lambda each have their own)
**/node_modules/

# Terraform: state, plans and variables can hold secrets; lambda.zip is
# built from lambda/ by Terraform.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
tfplan
*.zip
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Env files and credentials (example env files are committed)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
.aws/

# Logs
*.log
logs/

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Claude Code: shared setup is committed, personal settings stay local.
.claude/settings.local.json
.claude/*.local.*
.claude/worktrees/
CLAUDE.local.md
