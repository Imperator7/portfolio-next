# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform 
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.zip
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
tfplan
.terraformrc
terraform.rc

# secrets and credentials (keep example env files)
!.env.example
*.key
*.p12
*.pfx
credentials
.aws/

# logs
*.log
logs/

# OS / editor
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# AI coding agents (AI-DLC, Claude Code, Kiro, Amazon Q)
# Shared rules are committed: CLAUDE.md, AGENTS.md, .aidlc-rule-details/,
# .kiro/steering/, .amazonq/rules/, and aidlc-docs/ (design + decision record).
# Personal settings, caches and anything that can hold tokens stay local:
.claude/settings.local.json
.claude/*.local.*
.claude/worktrees/
CLAUDE.local.md
AGENTS.local.md
.mcp.local.json
.kiro/settings/
.amazonq/mcp.json
.amazonq/cache/
.aider*
