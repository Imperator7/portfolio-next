# Copy to .env and fill in. NEXT_PUBLIC_* values are inlined into the
# static build and visible to visitors, so only public keys go here.

# Cloudflare Turnstile site key (public). The production build stops without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: the contact API. Defaults to https://api.rungroj.dev
# NEXT_PUBLIC_API_URL=
